  IsDragging: 1
  IsSelected: 0
  _sentence:
    CharacterName: Narrator
    Text: "G\u1EEDi \u0111\u1EBFn nh\u1EEFng b\u1EADc ph\u1EE5 huynh, th\u1EA7y c\xF4,
      v\xE0 nh\u1EEFng ng\u01B0\u1EDDi b\u1EA1n ngo\xE0i kia\u2026 N\u1EBFu b\u1EA1n
      nh\u1EADn th\u1EA5y ng\u01B0\u1EDDi th\xE2n ho\u1EB7c b\u1EA1n b\xE8 c\u1EE7a
      m\xECnh \u0111ang mang nh\u1EEFng d\u1EA5u hi\u1EC7u b\u1ECB b\u1EAFt n\u1EA1t,
      xin \u0111\u1EEBng b\u1ECF qua. M\u1ED9t l\u1EDDi quan t\xE2m, m\u1ED9t c\xE1i
      nh\xECn th\u1EA5u hi\u1EC3u c\xF3 th\u1EC3 c\u1EE9u l\u1EA5y m\u1ED9t t\xE2m
      h\u1ED3n \u0111ang t\u1ED5n th\u01B0\u01A1ng."
    CharacterSprite: {fileID: 0}
  ParentNodes: []
  ChildNode: {fileID: -5495639235092302782}
