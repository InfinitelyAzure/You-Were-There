  IsSelected: 0
  _sentence:
    CharacterName: Narrator
    Text: "\u0110\u1EEBng ng\u1EA7n ng\u1EA1i g\u1ECDi **111** khi b\u1EA1n th\u1EA5y
      tr\u1EBB em ho\u1EB7c ng\u01B0\u1EDDi th\xE2n c\xF3 nguy c\u01A1 b\u1ECB b\u1EA1o
      l\u1EF1c, x\xE2m h\u1EA1i. Ngo\xE0i ra, b\u1EA1n c\u0169ng c\xF3 th\u1EC3 li\xEAn
      h\u1EC7 c\xE1c trung t\xE2m c\xF4ng t\xE1c x\xE3 h\u1ED9i t\u1EA1i \u0111\u1ECBa
      ph\u01B0\u01A1ng \u0111\u1EC3 \u0111\u01B0\u1EE3c h\u1ED7 tr\u1EE3 t\xE2m l\xFD
      v\xE0 ph\xE1p l\xFD"
    CharacterSprite: {fileID: 0}
